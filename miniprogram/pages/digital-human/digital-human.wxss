.dh-page { width: 100vw; height: 100vh; background: #0b274e; }
.dh-webview { width: 100%; height: 100%; }

/* cover-view 前景底部层（覆盖在 web-view 上，真机生效） */
.cv-bottom {
  position: absolute;
  left: 60rpx; right: 60rpx; bottom: calc(env(safe-area-inset-bottom, 0px) + 40rpx);
  display: flex; flex-direction: column; align-items: center;
}
.hold-talk {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f2994a, #e87d2e);
  color: #ffffff;
  font-size: 32rpx; font-weight: 700; letter-spacing: 6rpx;
  text-align: center;
}
.hold-talk.recording {
  background: linear-gradient(135deg, #d85a4a, #c74030);
}
.cv-privacy {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 21rpx; letter-spacing: 2rpx;
  text-align: center;
}

.dh-fallback {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 24rpx; background: #f7f5ef; color: #779189; font-size: 26rpx; padding: 60rpx;
  text-align: center; line-height: 1.8;
}
