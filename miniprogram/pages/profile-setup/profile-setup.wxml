<view class="setup-view safe-top">
  <!-- 顶栏：返回 + 标题 -->
  <view class="page-header">
    <view class="icon-button" hover-class="pressed" bindtap="goBack">
      <van-icon name="arrow-left" size="20px" />
    </view>
    <view class="header-title">简单认识一下</view>
    <view class="header-spacer" />
  </view>

  <view class="content">
    <view class="step-label">
      第 2 步 / 共 2 步
      <view class="step-track"><view class="tick" /><view class="tick filled" /></view>
    </view>

    <view class="section-title">
      <view>怎么称呼都行，</view>
      <view>自在最重要。</view>
    </view>
    <view class="muted intro">简单了解你，让这段陪伴更合拍。</view>

    <view class="profile-form">
      <!-- 年龄 -->
      <view>
        <view class="form-label">年龄 <text class="required">*</text></view>
        <input
          class="num-input"
          type="number"
          value="{{age}}"
          placeholder="请输入年龄"
          placeholder-class="num-placeholder"
          bindinput="onAgeInput"
        />
        <text wx:if="{{ageError}}" class="error">{{ageError}}</text>
      </view>

      <!-- 性别 -->
      <view>
        <view class="form-legend">性别</view>
        <view class="choice-row">
          <view
            wx:for="{{genders}}"
            wx:key="*this"
            class="choice {{gender === item ? 'active' : ''}}"
            hover-class="pressed"
            data-v="{{item}}"
            bindtap="onGender"
          >{{item}}</view>
        </view>
      </view>

      <!-- 职业（PRD 四选项）-->
      <view>
        <view class="form-legend">职业 <text class="required">*</text></view>
        <view class="occupation-grid">
          <view
            wx:for="{{jobs}}"
            wx:key="*this"
            class="choice {{job === item ? 'active' : ''}}"
            hover-class="pressed"
            data-v="{{item}}"
            bindtap="onJob"
          >{{item}}</view>
        </view>
      </view>

      <view class="info-note">
        <van-icon name="shield-o" size="19px" custom-style="color:#88a4c4" />
        <text class="info-text">资料仅用于让陪伴更懂你，不会公开给他人。</text>
      </view>

      <view class="primary-btn" hover-class="pressed" bindtap="onSubmit">
        {{submitting ? "正在进入…" : "开始聊聊"}}
      </view>
    </view>
  </view>
</view>
