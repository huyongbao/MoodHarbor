/* profile-setup —— Demo6 profile 屏（第 2 步 / 完善资料）*/
page {
  background: #f7f9fc;
  color: #29384b;
}

/* 按压反馈（hover-class） */
.pressed { opacity: 0.85; }

/* ---------- 顶栏 ---------- */
.page-header {
  height: 164rpx; padding: 36rpx 34rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-bottom: 1rpx solid #edf0f5;
}
.icon-button {
  min-height: 88rpx; min-width: 80rpx; margin-left: -14rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 24rpx; color: #29384b;
}
.header-title { font-size: 34rpx; font-weight: 600; }
.header-spacer { width: 80rpx; }

/* ---------- 内容区 ---------- */
.content { padding: 58rpx 48rpx 72rpx; }

.step-label {
  color: #2465b7; font-size: 22rpx; letter-spacing: 2rpx;
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 46rpx;
}
.step-track { display: flex; gap: 10rpx; }
.step-track .tick { width: 50rpx; height: 8rpx; border-radius: 6rpx; background: #dfe7f1; }
.step-track .tick:first-child, .step-track .tick.filled { background: #4389d5; }

.section-title { font-size: 52rpx; line-height: 1.6; letter-spacing: 1rpx; font-weight: 600; }
.muted { color: #8793a4; font-size: 26rpx; line-height: 1.8; }
.intro { margin: 18rpx 0 54rpx; }

/* ---------- 表单 ---------- */
.profile-form { display: flex; flex-direction: column; gap: 48rpx; }

.form-label { display: block; font-size: 28rpx; font-weight: 500; }
.form-legend { font-size: 28rpx; margin-bottom: 24rpx; }
.required { color: #cf7956; }

.num-input {
  display: block; width: 100%; height: 106rpx; margin-top: 22rpx; padding: 0 30rpx;
  box-sizing: border-box; background: #fff; border: 1rpx solid #edf0f5; border-radius: 24rpx;
  color: #29384b; font-weight: 400;
}
.num-placeholder { color: #8793a4; font-size: 26rpx; }
.error { display: block; margin-top: 14rpx; color: #d34c4c; font-size: 24rpx; }

.choice-row { display: flex; gap: 20rpx; }
.occupation-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.choice {
  flex: 1; min-height: 94rpx; padding: 0;
  border: 1rpx solid #edf0f5; border-radius: 20rpx; background: #fff;
  color: #29384b; font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
  text-align: center;
}
.choice.active { background: #f0f5fc; border-color: #589bdf; color: #2465b7; }

/* 信息注 */
.info-note {
  display: flex; align-items: flex-start; gap: 18rpx;
  padding: 30rpx 0; margin: 32rpx 0 10rpx; color: #8493a8;
}
.info-note .info-text { font-size: 22rpx; line-height: 1.9; }

/* 主按钮：橙渐变（对齐 Demo6 .button.primary） */
.primary-btn {
  width: 100%; min-height: 102rpx; border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center; gap: 18rpx;
  background: linear-gradient(110deg, #ff9a3d, #ff8022);
  color: #fff; font-size: 32rpx; font-weight: 600; letter-spacing: 1.4rpx;
  box-shadow: 0 10rpx 26rpx rgba(255, 138, 41, 0.15);
}
.primary-btn[disabled] { opacity: 0.45; }
