<view class="talk-page">
  <!-- 背景：3D 数字人 H5（数字人/字幕/转写区/热线卡全在 H5 内） -->
  <web-view wx:if="{{dhUrl}}" src="{{dhUrl}}" bindload="onWebviewLoad" bindmessage="onWebviewMessage" class="dh-webview">
    <!-- 前景原生层：按住说话（button 原生组件在 cover-view 内，touch 事件可靠） -->
    <cover-view class="cv-bottom">
      <button
        class="hold-talk {{recording ? 'recording' : ''}} {{processing ? 'processing' : ''}}"
        bindtouchstart="onHoldStart"
        bindtouchend="onHoldEnd"
        bindtouchcancel="onHoldEnd"
        hover-class="none"
      >{{recording ? "松开结束" : (processing ? "小满正在倾听…" : "按住开始说话")}}</button>
    </cover-view>
  </web-view>

  <!-- 未配置数字人：兜底提示（保留语音对话能力） -->
  <view wx:if="{{configured === false}}" class="dh-fallback">
    <text>3D 数字人未配置</text>
    <text class="fb-sub">请在 backend/.env 填写 DH_APP_ID_FEMALE / DH_APP_ID_MALE\n（魔珐星云 xingyun3d.com 创建驱动应用获取）后重启后端</text>
    <view class="fb-btn" bindtouchstart="onHoldStart" bindtouchend="onHoldEnd">{{recording ? "松开结束" : "按住开始说话"}}</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{configured === null}}" class="dh-fallback">
    <text>正在连接小满…</text>
  </view>

  <!-- 隐藏摄像头：表情识别取帧（1rpx 不可见，页面无摄像头画面） -->
  <camera wx:if="{{configured !== false}}" device-position="front" flash="off" class="hidden-camera" />
</view>
