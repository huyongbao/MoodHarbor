<view class="talk-page">
  <!-- 背景：3D 数字人 H5（数字人 / 字幕 / 按住说话按钮 / 热线卡全部在 H5 内）
       注意：cover-view 只能覆盖 map/video/canvas/camera/live-player/live-pusher，
       不支持覆盖 web-view，所以这里不能再放原生按钮，交互一律由 H5 承担 -->
  <!-- binderror：隧道断了/地址不可达时微信会回调，必须兜住。
       没有它，web-view 加载失败就是一片空白，用户完全不知道发生了什么 -->
  <web-view wx:if="{{dhUrl}}" src="{{dhUrl}}" bindload="onWebviewLoad" bindmessage="onWebviewMessage" binderror="onWebviewError" class="dh-webview" />

  <!-- 未配置/隧道不可达：兜底页（保留完整语音对话能力，只是没有 3D 形象） -->
  <view wx:if="{{configured === false}}" class="dh-fallback">
    <text>{{fallbackTitle}}</text>
    <text class="fb-sub">{{fallbackDesc}}</text>

    <!-- 2D 对话：3D 不可用时照样能倾诉、能拿到 AI 回复 -->
    <view class="fb-chat">
      <view wx:if="{{asrText}}" class="fb-bubble me">
        <text class="fb-who">您</text>{{asrText}}
      </view>
      <view wx:if="{{replyText}}" class="fb-bubble ai">
        <text class="fb-who">{{companionName}}</text>{{replyText}}
      </view>
    </view>

    <view class="fb-btn" bindtouchstart="onHoldStart" bindtouchend="onHoldEnd">{{recording ? "松开结束" : (processing ? "思考中…" : "按住开始说话")}}</view>
    <view wx:if="{{canRetry}}" class="fb-btn fb-btn-ghost" bindtap="onRetryWebview">重新加载数字人</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{configured === null}}" class="dh-fallback">
    <text>正在连接小满…</text>
  </view>

  <!-- 隐藏摄像头：表情识别取帧（1rpx 不可见，页面无摄像头画面） -->
  <camera wx:if="{{configured !== false}}" device-position="front" flash="off" class="hidden-camera" />
</view>
