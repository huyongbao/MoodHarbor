/* talk —— 沉浸式 3D 数字人对话页（方案 A）*/
.talk-page { width: 100vw; height: 100vh; background: #071f3d; position: relative; }
.dh-webview { width: 100%; height: 100%; }

/* ============ cover-view 前景：按住说话按钮 ============ */
.cv-bottom {
  position: absolute;
  left: 60rpx; right: 60rpx;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 90rpx);
  display: flex; flex-direction: column; align-items: center;
}
button.hold-talk {
  width: 100%;
  padding: 30rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f2994a, #e87d2e);
  color: #ffffff;
  font-size: 33rpx; font-weight: 700; letter-spacing: 6rpx;
  text-align: center;
  border: 0; line-height: 1.4; margin: 0;
}
button.hold-talk::after { border: 0; }
.hold-talk.recording {
  background: linear-gradient(135deg, #d85a4a, #c74030);
}
.hold-talk.processing {
  opacity: 0.75;
}

/* ============ 未配置兜底 ============ */
.dh-fallback {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 28rpx; background: #f7f5ef; color: #779189; font-size: 28rpx; padding: 60rpx;
  text-align: center; line-height: 1.8;
}
.fb-sub { font-size: 20rpx; color: #a2aaa7; }
.fb-btn {
  margin-top: 30rpx;
  width: 100%; max-width: 500rpx;
  padding: 28rpx 0; border-radius: 999rpx;
  background: linear-gradient(135deg, #f2994a, #e87d2e);
  color: #fff; font-size: 30rpx; font-weight: 700; letter-spacing: 4rpx;
  text-align: center;
}

.fb-btn-ghost {
  margin-top: 12rpx;
  padding: 20rpx 0;
  background: transparent;
  color: #779189;
  border: 2rpx solid #cfd6d3;
  font-size: 26rpx; font-weight: 500;
}

/* ============ 兜底页 2D 对话（3D 不可用时也能正常倾诉）============ */
.fb-chat {
  width: 100%; max-width: 560rpx;
  display: flex; flex-direction: column; gap: 16rpx;
  margin-bottom: 8rpx;
}
.fb-bubble {
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  font-size: 27rpx; line-height: 1.7;
  text-align: left;
  word-break: break-all;
}
.fb-bubble.me {
  align-self: flex-end;
  background: #e3ede7; color: #3c4d44;
  border-bottom-right-radius: 6rpx;
}
.fb-bubble.ai {
  align-self: flex-start;
  background: #fff; color: #3c4d44;
  border: 1rpx solid #e8e4dc;
  border-bottom-left-radius: 6rpx;
}
.fb-who { display: block; font-size: 18rpx; color: #a2aaa7; margin-bottom: 6rpx; }

/* ============ 隐藏摄像头（表情识别取帧，页面无画面）============ */
.hidden-camera {
  position: fixed;
  right: 0; bottom: 0;
  width: 1rpx; height: 1rpx;
  opacity: 0;
  pointer-events: none;
}
