<view class="page">
  <!-- 页头（Demo6 .tab-heading） -->
  <view class="tab-heading">
    <view class="eyebrow">A LITTLE SPACE FOR YOU</view>
    <view class="page-h1">我的</view>
    <view class="page-sub">奔波的日子，也记得照顾自己。</view>
  </view>

  <!-- 陪伴者身份卡（Demo6 .my-profile） -->
  <view class="my-profile">
    <image wx:if="{{companion && companion.avatarUrl}}" class="mp-avatar" src="{{companion.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="mp-avatar mp-avatar-fallback">友</view>
    <view class="mp-copy">
      <view class="mp-name">{{profile.occupation ? "路上的朋友" : "你好，路上的朋友"}}</view>
      <view class="mp-sub">{{profile.occupation ? profile.occupation + " · " + profile.age + " 岁" : "还没认识？聊聊时再慢慢来。"}}</view>
      <view class="profile-badge">{{profile.occupation ? "本机演示身份" : "访客 · 无需登录"}}</view>
    </view>
  </view>

  <!-- 设置组一：伙伴 / 基本信息 / 夜间模式 -->
  <view class="settings-group">
    <view class="setting-row" hover-class="pressed" bindtap="goCompanionEdit">
      <view class="setting-icon"><van-icon name="chat-o" size="42rpx" /></view>
      <view class="setting-label">聊天伙伴</view>
      <view class="setting-extra">{{companion.name || "小愈"}} · {{companion.trait || "温柔耐心"}}</view>
      <van-icon name="arrow" size="34rpx" custom-style="color:#a6b4c6" />
    </view>
    <view class="setting-row" hover-class="pressed" bindtap="goProfileEdit">
      <view class="setting-icon"><van-icon name="user-o" size="42rpx" /></view>
      <view class="setting-label">基本信息</view>
      <view class="setting-extra">{{profile.occupation ? "修改" : "未完善"}}</view>
      <van-icon name="arrow" size="34rpx" custom-style="color:#a6b4c6" />
    </view>
    <view class="setting-row" hover-class="pressed" bindtap="toggleDark">
      <view class="setting-icon"><van-icon name="closed-eye" size="42rpx" /></view>
      <view class="setting-label">夜间模式</view>
      <view class="toggle {{dark ? 'on' : ''}}"><view class="toggle-knob" /></view>
    </view>
  </view>

  <!-- 设置组二：帮助 / 隐私说明 -->
  <view class="settings-group">
    <view class="setting-row" hover-class="pressed" bindtap="goHotlines">
      <view class="setting-icon"><van-icon name="phone-o" size="42rpx" /></view>
      <view class="setting-label">需要更多帮助</view>
      <view class="setting-extra">帮助热线</view>
      <van-icon name="arrow" size="34rpx" custom-style="color:#a6b4c6" />
    </view>
    <view class="setting-row" hover-class="pressed" bindtap="goPrivacy">
      <view class="setting-icon"><van-icon name="shield-o" size="42rpx" /></view>
      <view class="setting-label">隐私与演示说明</view>
      <van-icon name="arrow" size="34rpx" custom-style="color:#a6b4c6" />
    </view>
  </view>

  <!-- 页脚插画与标语（Demo6 .mine-quote + BrandArt small） -->
  <view class="mine-quote">
    <image class="quote-art" src="/images/brand-art.png" mode="aspectFit" />
    <view class="mq-strong">下一单之前，先照顾好自己。</view>
    <view class="mq-sub">歇会儿 · 路上的情绪补给站</view>
  </view>
  <view class="page-footnote">交互原型 v1.0 · 所有智能能力均为预设演示</view>
</view>
