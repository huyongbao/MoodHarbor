/* 我的页 · Demo6 mine 页逐值移植（base 值 ×2 = rpx） */
.pressed { opacity: 0.85; }

.page {
  min-height: 100vh;
  box-sizing: border-box;
  /* Demo6 .tab-page 0 22px 25px；底部为 custom tabBar 让位 */
  padding: 0 44rpx calc(env(safe-area-inset-bottom) + 200rpx);
  background: #f7f9fc;
}

/* ---------- 页头（.tab-heading 43px 3px 28px，顶部另加状态栏安全区） ---------- */
.tab-heading {
  padding: calc(env(safe-area-inset-top) + 86rpx) 6rpx 56rpx;
}
.eyebrow { font-size: 18rpx; color: #8ca5c4; letter-spacing: 5rpx; }
.page-h1 {
  margin-top: 22rpx; font-size: 62rpx; font-weight: 700;
  letter-spacing: 2rpx; color: #29384b;
}
.page-sub { margin-top: 20rpx; font-size: 26rpx; color: #8793a4; }

/* ---------- 陪伴者身份卡（.my-profile） ---------- */
.my-profile {
  display: flex; gap: 32rpx; align-items: center;
  padding: 44rpx 36rpx;
  background: linear-gradient(120deg, #e6effb, #f0f5fb);
  border: 1rpx solid #dce8f8;
  border-radius: 36rpx;
  margin-bottom: 50rpx;
}
.mp-avatar {
  width: 130rpx; height: 130rpx; flex-shrink: 0;
  border-radius: 50%; background: #fafafa;
}
.mp-avatar-fallback {
  display: flex; align-items: center; justify-content: center;
  color: #9db4d0; font-size: 44rpx;
}
.mp-name { font-size: 38rpx; font-weight: 600; color: #29384b; }
.mp-sub { margin-top: 18rpx; font-size: 22rpx; color: #7d91ab; }
.profile-badge {
  display: inline-block; margin-top: 24rpx;
  font-size: 18rpx; letter-spacing: 1rpx;
  background: rgba(255, 255, 255, 0.44); color: #7893b4;
  border-radius: 10rpx; padding: 8rpx 14rpx;
}

/* ---------- 设置组（.settings-group / .setting-row） ---------- */
.settings-group {
  background: #ffffff;
  border: 1rpx solid #edf0f5;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 34rpx;
}
.setting-row {
  display: flex; align-items: center; gap: 22rpx;
  padding: 28rpx; min-height: 134rpx; box-sizing: border-box;
}
.setting-row + .setting-row { border-top: 1rpx solid #edf0f5; }
.setting-icon {
  width: 62rpx; height: 62rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  color: #7197c4;
}
.setting-label { flex: 1; font-size: 28rpx; color: #29384b; white-space: nowrap; }
.setting-extra { font-size: 20rpx; color: #8793a4; }

/* 夜间模式开关（Demo6 .toggle 37×23px） */
.toggle {
  width: 74rpx; height: 46rpx; flex-shrink: 0;
  background: #dce3ee; border-radius: 40rpx;
  padding: 6rpx; box-sizing: border-box;
  transition: background 0.2s;
}
.toggle-knob {
  width: 34rpx; height: 34rpx; background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(23, 52, 78, 0.08);
  transition: transform 0.2s;
}
.toggle.on { background: #4f8bd3; }
.toggle.on .toggle-knob { transform: translateX(28rpx); }

/* ---------- 页脚标语（.mine-quote，BrandArt small 160px 宽） ---------- */
.mine-quote {
  display: flex; flex-direction: column; align-items: center;
  position: relative; padding-top: 284rpx;
  text-align: center;
}
.quote-art {
  position: absolute; left: 50%; top: 8rpx;
  width: 320rpx; height: 264rpx;
  transform: translateX(-50%);
}
.mq-strong { font-size: 26rpx; font-weight: 400; color: #7b92ae; letter-spacing: 2rpx; }
.mq-sub { margin-top: 20rpx; font-size: 20rpx; color: #9aaabe; letter-spacing: 2rpx; }

.page-footnote {
  margin: 48rpx 0 0; text-align: center;
  font-size: 20rpx; color: #8793a4; line-height: 1.8;
}
