/* profile —— 我的 */
@import "../companion-select/companion-select.wxss";
@import "../history/history.wxss";

/* 用户卡 */
.profile-card {
  padding: 34rpx; display: flex; align-items: center; gap: 22rpx;
  border-radius: 41rpx; background: var(--color-panel);
}
.profile-avatar {
  width: 95rpx; height: 95rpx; display: flex; align-items: center; justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.75); border-radius: 50%;
  background: linear-gradient(145deg, #d69978, #f2c6a2); color: #fff; font-weight: 700; font-size: 34rpx;
}
.pc-copy { flex: 1; }
.pc-name { color: #36554d; font-size: 26rpx; font-weight: 700; }
.pc-sub { margin-top: 7rpx; color: #82948e; font-size: 17rpx; }
.profile-badge { padding: 9rpx 17rpx; border-radius: 37rpx; background: rgba(255, 255, 255, 0.65); color: #538071; font-size: 17rpx; }

.group-title { margin: 43rpx 6rpx 19rpx; color: #6f837d; font-size: 21rpx; font-weight: 500; letter-spacing: 2rpx; }

/* 陪伴卡 */
.companion-card {
  width: 100%; padding: 26rpx; display: flex; align-items: center; gap: 22rpx;
  border: 1rpx solid rgba(65, 96, 88, 0.07); border-radius: 35rpx; background: #fff; color: #50645e;
}
.companion-card .portrait-wrap { flex: 0 0 140rpx; width: 140rpx; height: 147rpx; border-radius: 45rpx; overflow: hidden; background: #dce9e3; }
.cc-copy { flex: 1; }
.cc-name { font-size: 22rpx; font-weight: 600; }
.cc-sub { margin-top: 7rpx; color: #98a29f; font-size: 17rpx; }

/* 设置列表 */
.settings-list { overflow: hidden; border: 1rpx solid rgba(65, 96, 88, 0.07); border-radius: 35rpx; background: #fff; }
.setting-item {
  display: flex; align-items: center; padding: 22rpx 26rpx; margin: 0 22rpx;
  border-bottom: 1rpx solid rgba(65, 96, 88, 0.07);
}
.setting-item:last-child { border-bottom: 0; margin-bottom: 22rpx; }
.setting-icon {
  width: 64rpx; height: 64rpx; margin-right: 19rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 21rpx; background: #edf3f0; color: #5d8378; font-size: 28rpx;
}
.setting-label { flex: 1; color: #4b625b; font-size: 21rpx; font-weight: 600; }
.sl-sub { margin-top: 6rpx; color: #a0a9a6; font-size: 15rpx; font-weight: 400; }

.chevron.small { width: 12rpx; height: 12rpx; border-width: 3rpx; opacity: 0.5; }

.disclaimer { margin: 41rpx 37rpx 0; color: #a2aaa7; font-size: 17rpx; line-height: 1.6; text-align: center; }
