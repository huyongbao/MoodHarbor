/* history —— 倾诉记录 */
.sub-view { min-height: 100vh; padding: 26rpx 41rpx 78rpx; box-sizing: border-box; }
.sub-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 41rpx; }
.round-action {
  width: 69rpx; height: 69rpx; display: flex; align-items: center; justify-content: center;
  border: 1rpx solid rgba(52, 88, 78, 0.08); border-radius: 50%; background: #fff; color: #68837b;
  font-size: 26rpx; padding: 0; line-height: 1;
}
.round-action::after { border: 0; }

/* 情绪天气卡 */
.insight-card {
  padding: 35rpx; border-radius: 43rpx;
  background: linear-gradient(140deg, #426e62, #79978b); color: #fff;
  box-shadow: 0 26rpx 52rpx rgba(54, 91, 81, 0.16);
}
.insight-label { font-size: 19rpx; opacity: 0.75; letter-spacing: 2rpx; }
.insight-main { display: flex; gap: 28rpx; align-items: center; margin-top: 22rpx; }
.weather-mark { position: relative; width: 95rpx; height: 73rpx; }
.weather-mark .w { position: absolute; bottom: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.88); }
.weather-mark .w1 { width: 56rpx; height: 56rpx; left: 0; }
.weather-mark .w2 { width: 71rpx; height: 71rpx; left: 19rpx; }
.weather-mark .w3 { width: 47rpx; height: 47rpx; right: 0; }
.insight-strong { font-size: 34rpx; font-weight: 700; }
.insight-sub { margin-top: 6rpx; font-size: 19rpx; opacity: 0.74; }

.date-label { margin: 41rpx 4rpx 15rpx; color: #80918c; font-size: 19rpx; letter-spacing: 2rpx; }

/* 记录列表 */
.history-item {
  width: 100%; padding: 24rpx 7rpx; display: flex; align-items: center;
  border-bottom: 1rpx solid rgba(62, 88, 81, 0.07); background: transparent;
}
.history-dot {
  width: 17rpx; height: 17rpx; margin: 0 24rpx 0 7rpx; border: 4rpx solid #5c8a7d;
  border-radius: 50%; box-shadow: 0 0 0 7rpx #e1ece7; flex: 0 0 auto;
}
.history-copy { flex: 1; display: flex; flex-direction: column; }
.hi-title { font-size: 22rpx; font-weight: 600; color: #405c54; }
.hi-desc { margin-top: 7rpx; color: #929d99; font-size: 17rpx; }
.history-time { display: flex; align-items: center; gap: 9rpx; color: #9aa5a1; font-size: 17rpx; }

.empty-tip { padding: 78rpx 0; text-align: center; color: var(--text-muted); font-size: 21rpx; }
