/* 倾诉记录 —— Demo6 records 页逐值移植（base 值 ×2 = rpx） */
page {
  background: #f7f9fc;
  color: #29384b;
}
.pressed { opacity: 0.85; }

.page {
  min-height: 100vh;
  box-sizing: border-box;
  /* Demo6 .tab-page 0 22px 25px；底部为 custom tabBar 让位 */
  padding: 0 44rpx calc(env(safe-area-inset-bottom) + 200rpx);
}

/* ---------- 页头（.tab-heading 43px 3px 28px，顶部另加状态栏安全区） ---------- */
.tab-heading {
  padding: calc(env(safe-area-inset-top) + 86rpx) 6rpx 56rpx;
}
.eyebrow { font-size: 18rpx; color: #8ca5c4; letter-spacing: 5rpx; }
.heading-row { display: flex; align-items: center; justify-content: space-between; }
.page-h1 {
  margin-top: 22rpx; font-size: 62rpx; font-weight: 700;
  letter-spacing: 2rpx; color: #29384b;
}
/* Demo6 .subtle-button：清空（仅列表非空时显示） */
.subtle-clear {
  display: flex; align-items: center; gap: 8rpx;
  min-height: 88rpx; color: #8793a4; font-size: 22rpx;
}
.page-sub { margin-top: 20rpx; font-size: 26rpx; color: #8793a4; }

/* ---------- 空状态（Demo6 .empty-state 66px 10px 45px） ---------- */
.empty-state { padding: 132rpx 20rpx 90rpx; text-align: center; }
.empty-icon {
  width: 220rpx; height: 220rpx; margin: 0 auto 56rpx;
  display: flex; align-items: center; justify-content: center;
  background: #eaf1fa; border-radius: 80rpx; color: #83a7d2;
  transform: rotate(-7deg);
}
.es-title { font-size: 40rpx; font-weight: 600; color: #29384b; }
.es-copy { margin: 32rpx 0 56rpx; font-size: 26rpx; line-height: 2; color: #8793a4; }
/* Demo6 .button primary（橙渐变） */
.chat-cta {
  max-width: 440rpx; margin: 0 auto; min-height: 102rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 28rpx;
  background: linear-gradient(110deg, #ff9a3d, #ff8022);
  color: #ffffff; font-size: 32rpx; font-weight: 600; letter-spacing: 1rpx;
  box-shadow: 0 10rpx 26rpx rgba(255, 138, 41, 0.15);
}

/* ---------- 记录列表（Demo6 .record-card） ---------- */
.record-list { display: flex; flex-direction: column; gap: 28rpx; }
.record-card {
  background: #ffffff;
  border: 1rpx solid #edf0f5;
  border-radius: 32rpx;
  overflow: hidden;
}
.record-main {
  display: flex; align-items: center; gap: 22rpx;
  padding: 36rpx 28rpx;
}
.record-icon {
  width: 80rpx; height: 86rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: #f0f5fc; color: #2465b7; border-radius: 24rpx;
}
.rm-copy { flex: 1; min-width: 0; }
.rm-time { font-size: 20rpx; color: #8793a4; }
.rm-title { margin: 14rpx 0; font-size: 30rpx; font-weight: 600; color: #29384b; }
.rm-desc {
  font-size: 22rpx; color: #8793a4;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.record-footer {
  display: flex; align-items: center; justify-content: space-between;
  border-top: 1rpx solid #edf0f5;
  padding: 6rpx 32rpx;
  color: #8793a4; font-size: 18rpx;
}
.rf-del {
  min-width: 70rpx; min-height: 70rpx;
  display: flex; align-items: center; justify-content: center;
  color: #8793a4;
}

/* ---------- 脚注（Demo6 .page-footnote） ---------- */
.page-footnote {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  margin: 48rpx 0 0;
  font-size: 20rpx; color: #8793a4; text-align: center; line-height: 1.8;
}
