<view class="page">
  <!-- 页头（Demo6 .tab-heading）：眉题 + 标题行（清空靠右）+ 副标题 -->
  <view class="tab-heading">
    <view class="eyebrow">YOUR MOMENTS</view>
    <view class="heading-row">
      <view class="page-h1">倾诉记录</view>
      <view wx:if="{{list.length}}" class="subtle-clear" hover-class="pressed" bindtap="onClearAll">
        <van-icon name="delete-o" size="34rpx" />
        <text>清空</text>
      </view>
    </view>
    <view class="page-sub">说出来的心事，都在这里。</view>
  </view>

  <!-- 空状态（Demo6 .empty-state） -->
  <view wx:if="{{!list.length}}" class="empty-state">
    <view class="empty-icon">
      <van-icon name="notes-o" size="86rpx" custom-style="transform:rotate(7deg)" />
    </view>
    <view class="es-title">心事，可以从这里放下。</view>
    <view class="es-copy">
      <view>还没有倾诉记录。</view>
      <view>想说的时候，随时来坐坐。</view>
    </view>
    <view class="chat-cta" hover-class="pressed" bindtap="goChat">去聊聊</view>
  </view>

  <!-- 记录列表（Demo6 .record-card） -->
  <view wx:else class="record-list">
    <view class="record-card" wx:for="{{list}}" wx:key="id">
      <view class="record-main" hover-class="pressed" data-id="{{item.id}}" bindtap="onItem">
        <view class="record-icon"><van-icon name="chat-o" size="46rpx" /></view>
        <view class="rm-copy">
          <view class="rm-time">{{item.time}}</view>
          <view class="rm-title">{{item.title}}</view>
          <view class="rm-desc">{{item.desc}}</view>
        </view>
        <van-icon name="arrow" size="32rpx" />
      </view>
      <view class="record-footer">
        <text>{{item.count}} 条消息 · 仅本机可见</text>
        <view class="rf-del" hover-class="pressed" data-id="{{item.id}}" bindtap="onDel">
          <van-icon name="delete-o" size="30rpx" />
        </view>
      </view>
    </view>
  </view>

  <!-- 脚注（Demo6 .page-footnote） -->
  <view class="page-footnote">
    <van-icon name="shield-o" size="28rpx" />
    <text>记录仅存于本机，请勿保存敏感信息</text>
  </view>
</view>
