/* hotlines —— 免费援助（Demo6 蓝白风格：soft 底卡片 + 蓝色操作） */
page {
  background: #f7f9fc;
  color: #29384b;
}

.pressed { opacity: 0.85; }

.hl-view {
  min-height: 100vh;
  padding: 13rpx 41rpx calc(78rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- 页头 ---------- */
.page-header {
  height: 88rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.header-spacer { width: 68rpx; }
.hl-titles { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.hl-eyebrow { color: #8793a4; font-size: 20rpx; letter-spacing: 3rpx; }
.hl-title { color: #29384b; font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; }

/* ---------- 引导语（Demo6 modal-copy 文案） ---------- */
.hl-intro { margin-top: 6rpx; color: #29384b; font-size: 28rpx; line-height: 1.75; }

/* ---------- 热线卡片（Demo6 .hotline-card，px ×2 → rpx） ---------- */
.hotline-list { display: flex; flex-direction: column; }
.hotline-card {
  display: flex; align-items: center; gap: 16rpx;
  padding: 30rpx 24rpx; margin: 24rpx 0;
  background: #f0f5fc; border-radius: 26rpx;
}
.hc-main { flex: 1; }
.hc-name { display: block; margin-bottom: 16rpx; color: #8793a4; font-size: 20rpx; }
.hc-num { display: block; color: #29384b; font-size: 40rpx; font-weight: 650; letter-spacing: 1rpx; }
.hc-dial {
  min-width: 66rpx; min-height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  color: #2465b7;
}
.hc-copy {
  min-width: 66rpx; min-height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  color: #2465b7; font-size: 20rpx;
}

/* ---------- 脚注（Demo6 small.muted） ---------- */
.hl-note { margin-top: 10rpx; color: #8793a4; font-size: 20rpx; line-height: 1.7; }

/* ---------- 紧急求助入口（安全警示保留暖色，柔和不抢主界面） ---------- */
.emergency-link {
  width: 100%; margin-top: 44rpx; min-height: 92rpx;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid rgba(176, 92, 71, 0.16); border-radius: 26rpx;
  background: #fdf1ec; color: #b05c47; font-size: 24rpx; padding: 0;
}
.emergency-link::after { border: 0; }

/* ---------- 紧急弹窗（Demo6 care 一级） ---------- */
.modal-backdrop {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 30;
  display: flex; align-items: center; justify-content: center;
  background: rgba(24, 36, 54, 0.45);
}
.emergency-modal {
  width: 640rpx; padding: 50rpx 40rpx 40rpx;
  border-radius: 40rpx; background: #fff; text-align: center;
  box-shadow: 0 30rpx 80rpx rgba(15, 40, 80, 0.28);
}
.care-circle {
  width: 120rpx; height: 120rpx; margin: 0 auto 26rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: #fdeeea; color: #c4674f;
}
.em-title { color: #29384b; font-size: 34rpx; font-weight: 700; }
.em-copy { margin: 18rpx 0 26rpx; color: #8793a4; font-size: 24rpx; line-height: 1.75; }
.em-cards { display: flex; flex-direction: column; text-align: left; }
.em-card {
  display: flex; align-items: center; gap: 16rpx;
  padding: 26rpx 24rpx; margin: 14rpx 0;
  background: #f0f5fc; border-radius: 26rpx;
}
.emc-main { flex: 1; }
.emc-label { display: block; margin-bottom: 10rpx; color: #8793a4; font-size: 20rpx; }
.emc-num { display: block; color: #29384b; font-size: 36rpx; font-weight: 650; letter-spacing: 1rpx; }
.emc-dial {
  min-width: 60rpx; min-height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  color: #2465b7;
}
.modal-close-btn {
  width: 100%; margin-top: 30rpx; min-height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border: 0; border-radius: 26rpx;
  background: #f0f5fc; color: #2465b7; font-size: 26rpx; font-weight: 600;
}
.modal-close-btn::after { border: 0; }
