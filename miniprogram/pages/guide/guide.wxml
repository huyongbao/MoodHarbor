<view class="onboarding safe-top guide-theme-{{guideIndex}}">
  <van-button custom-class="skip-button" bindtap="onSkip">跳过</van-button>

  <view class="guide-visual">
    <view class="guide-number">{{pages[guideIndex].step}}</view>
    <view class="guide-orbit orbit-one"></view>
    <view class="guide-orbit orbit-two"></view>

    <!-- 第一页：骑手场景 -->
    <block wx:if="{{guideIndex === 0}}">
      <view class="rider-scene">
        <view class="rider-helmet"></view>
        <view class="rider-head"></view>
        <view class="rider-body"></view>
        <view class="rider-box">今日\n已送 32 单</view>
      </view>
    </block>

    <!-- 第二页：陪伴者 -->
    <block wx:if="{{guideIndex === 1}}">
      <view class="portrait-figure">
        <image class="portrait-figure-img" src="/images/avatars/xiaoman.jpg" mode="aspectFill" />
      </view>
    </block>

    <!-- 第三页：安全 -->
    <block wx:if="{{guideIndex === 2}}">
      <view class="safe-visual">
        <view class="safe-icon"></view>
        <view class="safe-text">对话加密</view>
      </view>
      <view class="safe-line"></view>
    </block>
  </view>

  <view class="guide-content">
    <view class="guide-tag">{{pages[guideIndex].tag}}</view>
    <view class="guide-h1">{{pages[guideIndex].title}}</view>
    <view class="guide-copy">{{pages[guideIndex].copy}}</view>

    <view class="guide-dots">
      <view class="dot {{guideIndex === 0 ? 'active' : ''}}"></view>
      <view class="dot {{guideIndex === 1 ? 'active' : ''}}"></view>
      <view class="dot {{guideIndex === 2 ? 'active' : ''}}"></view>
    </view>

    <van-button custom-class="btn-primary" bindtap="onNext">
      {{guideIndex < 2 ? '下一步' : '开始使用'}}
      <van-icon name="arrow" size="14px" custom-style="opacity:.6" />
    </van-button>
  </view>
</view>
