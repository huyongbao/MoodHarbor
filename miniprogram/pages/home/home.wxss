/* home —— Demo6「歇会儿。」首页（蓝渐变 + 橙 CTA） */
page {
  background: #194c95;
}

.home {
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  /* Demo6 .home padding-top 25px×2 + 状态栏（原 safe-top 的 88rpx 偏大，改为源码值） */
  padding-top: calc(env(safe-area-inset-top) + 50rpx);
  /* 底部为 custom tabBar 让位（tabBar 高约 156rpx + 安全区） */
  padding-bottom: calc(env(safe-area-inset-bottom) + 200rpx);
  background: linear-gradient(166deg, #194c95 0%, #1e5aab 37%, #3379c7 65%, #d8e9fa 88%, #f0f6fd 100%);
}

/* 按压反馈（hover-class） */
.pressed { opacity: 0.85; }

/* ---------- 顶栏 ---------- */
.home-topline {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 54rpx; color: #d3e4fc;
}
.wordmark {
  display: flex; align-items: center; gap: 14rpx;
  font-size: 22rpx; letter-spacing: 4rpx;
}
.brand-dot { width: 12rpx; height: 12rpx; background: #a9d7ff; border-radius: 50%; }
.home-help {
  width: 68rpx; height: 68rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.19); border-radius: 50%; color: #d2e6ff;
}

/* ---------- 品牌区 ---------- */
.home-brand { position: relative; z-index: 1; padding: 52rpx 60rpx 0; color: #fff; }
.brand-eyebrow { font-size: 18rpx; letter-spacing: 7rpx; opacity: 0.5; margin-bottom: 10rpx; }
.home-h1 {
  font-size: 114rpx; letter-spacing: 4rpx; font-weight: 800; line-height: 1.35;
  text-shadow: 0 4rpx 6rpx rgba(17, 59, 126, 0.12);
}
.title-period { font-size: 88rpx; color: #99c8ff; letter-spacing: -14rpx; }
.home-slogan { margin-top: 12rpx; font-size: 36rpx; letter-spacing: 3rpx; font-weight: 400; color: #eef6ff; }

/* ---------- 主视觉 ---------- */
.hero-art { position: relative; height: 570rpx; margin-top: 18rpx; }
.hero-orbit {
  position: absolute; left: 50%; transform: translateX(-50%);
  border: 1rpx solid rgba(255, 255, 255, 0.035); border-radius: 50%;
}
.orbit-one { width: 520rpx; height: 520rpx; top: 16rpx; background: rgba(106, 180, 244, 0.03); }
.orbit-two { width: 670rpx; height: 670rpx; top: -54rpx; }
/* Demo6 BrandArt SVG 原样导出（viewBox 400×330），top 7px→14rpx；宽高按用户要求去掉（image 组件默认 320×240px） */
.brand-art {
  position: absolute; z-index: 1; left: 50%; top: 14rpx; transform: translateX(-50%);
}

.topic-bubble {
  position: absolute; z-index: 2; color: #f2f8ff;
  background: linear-gradient(130deg, rgba(104, 169, 224, 0.3), rgba(128, 186, 244, 0.16));
  border: 1rpx solid rgba(178, 214, 243, 0.18);
  box-shadow: inset 0 2rpx rgba(255, 255, 255, 0.05);
  border-radius: 48rpx; padding: 20rpx 30rpx;
  font-size: 30rpx; letter-spacing: 1rpx; white-space: nowrap;
}
.topic-bubble::after {
  content: ""; position: absolute; bottom: -14rpx; right: 34rpx;
  border-top: 16rpx solid rgba(121, 181, 239, 0.33);
  border-left: 18rpx solid transparent;
  transform: rotate(-8deg);
}
.bubble-0 { top: 56rpx; left: 50rpx; transform: rotate(-5deg); }
.bubble-1 { top: 280rpx; left: 28rpx; font-size: 28rpx; transform: rotate(-3deg); }
.bubble-2 { top: 10rpx; right: 52rpx; transform: rotate(4deg); }
.bubble-3 {
  top: 388rpx; right: 28rpx; font-size: 26rpx; transform: rotate(2deg);
  background: linear-gradient(130deg, rgba(197, 216, 184, 0.3), rgba(197, 213, 236, 0.24));
}
.hero-caption {
  position: absolute; bottom: 30rpx; left: 0; right: 0;
  display: flex; align-items: center; justify-content: center; gap: 20rpx;
  color: #d2e8ff; font-size: 22rpx; letter-spacing: 4rpx;
}
.cap-line { width: 38rpx; height: 2rpx; background: rgba(175, 213, 246, 0.33); }

/* ---------- 倾诉主卡 ---------- */
.home-cards { position: relative; z-index: 3; padding: 46rpx 40rpx 26rpx; }
.talk-card {
  padding: 36rpx 46rpx 40rpx; color: #29384b;
  background: #fff; border-radius: 44rpx;
  box-shadow: 0 16rpx 50rpx rgba(15, 67, 138, 0.125);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}
.talk-card-top {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 18rpx; color: #9fb6cf;
}
.mini-label { display: flex; align-items: center; gap: 12rpx; font-size: 22rpx; letter-spacing: 2rpx; color: #7b92ae; }
.mini-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #6b9cce; }
.talk-h2 { font-size: 48rpx; font-weight: 700; letter-spacing: 1rpx; }
.talk-p { margin-top: 14rpx; font-size: 26rpx; color: #8793a4; }
.talk-cta {
  margin-top: 40rpx; min-height: 106rpx; padding: 0 36rpx;
  display: flex; align-items: center; gap: 18rpx;
  border-radius: 26rpx; color: #fff;
  background: linear-gradient(110deg, #ff9a3d, #ff8022);
  box-shadow: 0 10rpx 26rpx rgba(255, 138, 41, 0.15);
  font-size: 36rpx; font-weight: 600; letter-spacing: 1.4rpx;
}
/* 图三对齐：左右图标贴边、文字绝对居中（两侧等宽撑开，不依赖 van-icon margin） */
.cta-side { flex: 1; display: flex; align-items: center; }
.cta-side-right { justify-content: flex-end; }

/* ---------- 快捷功能三列 ---------- */
.feature-card {
  display: flex; margin-top: 32rpx; padding: 40rpx 0 34rpx;
  background: #fff; border-radius: 38rpx;
  box-shadow: 0 14rpx 46rpx rgba(23, 60, 115, 0.07);
}
.feature-item {
  width: 33.333%; position: relative;
  display: flex; flex-direction: column; align-items: center; gap: 14rpx;
}
.feature-item.has-line::before {
  content: ""; position: absolute; width: 2rpx; left: 0; top: 18rpx; bottom: 18rpx;
  background: #edf0f5;
}
.feature-icon {
  width: 96rpx; height: 86rpx; margin-bottom: 4rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 30rpx;
}
.fi-0 { color: #4b93d0; background: #eef6ff; }
.fi-1 { color: #3cadb2; background: #eaf9f7; }
.fi-2 { color: #547aa9; background: #f0f4fa; }
.fi-img { width: 30px; height: 30px; }
.fi-strong { font-size: 30rpx; font-weight: 600; color: #29384b; }
.fi-sub { font-size: 20rpx; letter-spacing: 1rpx; color: #8793a4; }

/* ---------- 页脚 ---------- */
.home-bottom {
  margin-top: 42rpx;
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  color: #6b86a6; font-size: 22rpx; letter-spacing: 2rpx;
}
.home-privacy {
  margin: 18rpx auto 0;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  color: #879bb3; font-size: 20rpx;
}
/* 数字人预载隐藏 web-view（1rpx 不可见，仅预热 SDK 资源缓存） */
.preload-webview {
  position: fixed;
  right: 0; bottom: 0;
  width: 1rpx; height: 1rpx;
  opacity: 0;
  pointer-events: none;
}
