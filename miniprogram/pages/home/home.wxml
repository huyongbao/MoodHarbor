<view class="home">
  <!-- 顶栏：品牌字标 + 关于/我的 -->
  <view class="home-topline">
    <view class="wordmark"><view class="brand-dot" />路上的情绪补给站</view>
    <view class="home-help" hover-class="pressed" bindtap="goProfile">
      <van-icon name="info-o" size="19px" />
    </view>
  </view>

  <!-- 品牌区 -->
  <view class="home-brand">
    <view class="brand-eyebrow">{{greeting}}</view>
    <view class="home-h1">歇会儿<text class="title-period">。</text></view>
    <view class="home-slogan">先停一分钟，心里别硬扛</view>
  </view>

  <!-- 主视觉：BrandArt 插画 + 话题气泡 -->
  <view class="hero-art">
    <view class="hero-orbit orbit-one" />
    <view class="hero-orbit orbit-two" />
    <image class="brand-art" src="/images/brand-art.png" mode="aspectFit" />
    <view
      wx:for="{{topics}}"
      wx:key="*this"
      class="topic-bubble bubble-{{index}}"
      hover-class="pressed"
      data-topic="{{item}}"
      bindtap="onTopicTap"
    >{{item}}</view>
    <view class="hero-caption"><text class="cap-line" />这一站，为自己停一下<text class="cap-line" /></view>
  </view>

  <!-- 倾诉主卡 + 快捷功能 -->
  <view class="home-cards">
    <view class="talk-card">
      <view class="talk-card-top">
        <view class="mini-label"><text class="mini-dot" />随时想说，随时都在</view>
        <van-icon name="chat-o" size="23px" />
      </view>
      <view class="talk-h2">今天遇到什么事？</view>
      <view class="talk-p">不必一个人消化，来这儿说说。</view>
      <view class="talk-cta" hover-class="pressed" bindtap="goTalk">
        <view class="cta-side"><van-icon name="chat-o" size="22px" /></view>
        <text>我想聊聊</text>
        <view class="cta-side cta-side-right"><van-icon name="arrow" size="20px" /></view>
      </view>
    </view>

    <view class="feature-card">
      <view class="feature-item" hover-class="pressed" bindtap="goHotlines">
        <view class="feature-icon fi-0"><van-icon name="phone-o" size="30px" /></view>
        <text class="fi-strong">免费援助</text>
        <text class="fi-sub">随时有人能接</text>
      </view>
      <view class="feature-item has-line" hover-class="pressed" bindtap="goBreath">
        <view class="feature-icon fi-1"><image class="fi-img" src="/images/icon-breath.png" /></view>
        <text class="fi-strong">呼吸一下</text>
        <text class="fi-sub">跟着慢慢来</text>
      </view>
      <view class="feature-item has-line" hover-class="pressed" bindtap="goStories">
        <view class="feature-icon fi-2"><image class="fi-img" src="/images/icon-story.png" /></view>
        <text class="fi-strong">同行故事</text>
        <text class="fi-sub">有人和你懂</text>
      </view>
    </view>

    <view class="home-bottom">
      <van-icon name="shield-o" size="15px" />
      <text>先停稳车，再安心聊。</text>
    </view>
    <view class="home-privacy"><van-icon name="lock" size="12px" /> 你的倾诉已加密保护，不会公开给他人</view>
  </view>
</view>
