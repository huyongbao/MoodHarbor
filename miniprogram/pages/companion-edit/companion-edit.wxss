/* companion-edit —— Demo6 partners 页（edit 模式）逐值移植（base 值 ×2 = rpx） */
page {
  background: #f7f9fc;
  color: #29384b;
}
.pressed { opacity: 0.85; }

.page { min-height: 100vh; box-sizing: border-box; }

/* ---------- 页头（Demo6 .page-header 82px 18px 17px 白底 + 底部分隔线） ---------- */
.page-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 36rpx) 34rpx 36rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f5;
  position: sticky; top: 0; z-index: 5;
}
.icon-button {
  min-width: 80rpx; min-height: 88rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  color: #29384b;
}
.ph-mid { text-align: center; }
.ph-title { font-size: 34rpx; font-weight: 600; }
.header-spacer { width: 80rpx; }

/* ---------- 内容（Demo6 .content 29px 24px 36px） ---------- */
.content { padding: 58rpx 48rpx 72rpx; }

/* 步骤标签（Demo6 .step-label 11px + .step-track） */
.step-label {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 46rpx;
  color: #4389d5; font-size: 22rpx; letter-spacing: 2rpx;
}
.step-track { display: flex; gap: 10rpx; }
.step-track .bar { width: 50rpx; height: 8rpx; border-radius: 6rpx; background: #dfe7f1; }
.step-track .bar.filled { background: #4389d5; }

.section-title { font-size: 52rpx; line-height: 1.6; letter-spacing: 0.6rpx; font-weight: 650; }
.intro { margin-top: 20rpx; font-size: 26rpx; color: #8793a4; }

/* ---------- 伙伴卡（Demo6 .partner-list gap 13px / .partner-card） ---------- */
.partner-list { display: flex; flex-direction: column; gap: 26rpx; margin-top: 44rpx; }
.partner-card {
  display: flex; align-items: center; gap: 26rpx;
  padding: 38rpx 30rpx;
  background: #ffffff;
  border: 3rpx solid #edf0f5;
  border-radius: 36rpx;
  position: relative;
}
.partner-card.selected {
  border-color: #4d92df;
  background: #f0f5fc;
  box-shadow: 0 6rpx 20rpx rgba(50, 105, 176, 0.04);
}
/* Demo6 .avatar.partner-portrait 86×139px 圆角 12px */
.portrait {
  width: 172rpx; height: 278rpx; flex-shrink: 0;
  border-radius: 24rpx; overflow: hidden;
  background: #e9eef5;
}
.portrait-img { width: 100%; height: 100%; }
.pc-copy { flex: 1; min-width: 0; }
.pc-name { display: flex; align-items: center; gap: 20rpx; font-size: 36rpx; font-weight: 650; }
.pc-trait {
  font-size: 20rpx; font-weight: 400; color: #4389d5;
  background: rgba(108, 165, 227, 0.09);
  padding: 6rpx 12rpx; border-radius: 10rpx;
}
.pc-desc { margin-top: 16rpx; font-size: 22rpx; line-height: 1.7; }

/* Demo6 .radio 19px 圆形；选中 #4389d5 填充 + 白色对勾 */
.radio {
  width: 38rpx; height: 38rpx; flex-shrink: 0;
  margin-left: auto;
  border: 3rpx solid #c8d4e4; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.radio.on { background: #4389d5; border-color: #4389d5; }

/* ---------- 提示（Demo6 .info-note 15px 0 / 11px 1.9） ---------- */
.info-note {
  display: flex; align-items: flex-start; gap: 18rpx;
  padding: 30rpx 0; margin: 32rpx 0 10rpx;
  color: #8493a8;
}
.in-text { flex: 1; font-size: 22rpx; line-height: 1.9; }

/* ---------- 确认按钮（Demo6 .button primary 橙渐变 51px） ---------- */
.confirm-btn {
  min-height: 102rpx; margin-top: 32rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 28rpx;
  background: linear-gradient(110deg, #ff9a3d, #ff8022);
  color: #ffffff; font-size: 32rpx; font-weight: 600; letter-spacing: 1rpx;
  box-shadow: 0 10rpx 26rpx rgba(255, 138, 41, 0.15);
}
