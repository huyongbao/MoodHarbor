# 后端环境变量模板：复制为 .env 或直接 export
# LLM 大模型（必填）—— DeepSeek 官方 API
# 可选 deepseek-flash（快、支持图文）/ deepseek-v4-pro（更谨慎、纯文本）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的密钥
LLM_MODEL=deepseek-flash

# JWT 密钥（生产环境务必更换）
JWT_SECRET=moodharbor-dev-secret-change-in-prod

# 微信小程序（真机联调时填）
WX_LOGIN_MOCK=true
WX_APPID=wx96266f6a77bb3c94
WX_SECRET=

# 魔珐星云 3D 数字人（xingyun3d.com 创建驱动应用获取）
# 小满（女，dh_01）
DH_APP_ID_FEMALE=
DH_APP_SECRET_FEMALE=
# 知远（男，dh_02）
DH_APP_ID_MALE=
DH_APP_SECRET_MALE=
